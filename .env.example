# Variables públicas para activar el adaptador Supabase (Etapa 5).
# Son públicas por diseño (NEXT_PUBLIC_*): terminan expuestas en el bundle
# del navegador. Nunca poner acá una clave secreta (service_role) — esa va
# SOLO en .env.migration.example / .env.migration.local, sin prefijo
# NEXT_PUBLIC_, y ningún código de src/ la importa jamás.

# URL del proyecto (Project Settings → API → Project URL).
# Ejemplo de formato (valor ficticio, no es un proyecto real):
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmno.supabase.co

# Clave publicable (Project Settings → API → Publishable key). Es la opción
# PRINCIPAL — Supabase la reemplaza gradualmente por la anon key legacy.
# Ejemplo de formato (valor ficticio, no es una clave real):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EJEMPLO_FICTICIO_NO_ES_REAL

# Alias legacy: si tu proyecto todavía no rotó a la publishable key, podés
# usar la anon key acá en su lugar (mismo formato JWT de siempre). Si las
# dos están definidas, PUBLISHABLE_KEY tiene prioridad.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EJEMPLO.FICTICIO

# Selector de proveedor. Sin definir o "local": usa el adaptador local
# (localStorage). "supabase": exige que las variables de arriba sean
# válidas — si faltan o son inválidas, la app FALLA de forma visible en vez
# de usar Local en silencio (evita datos divergentes entre dispositivos).
# Ver "Rollback" en supabase/README.md para volver a local a propósito.
NEXT_PUBLIC_PERSISTENCE_PROVIDER=local

# Configuración de dominios (Etapa 6 — Despliegue separado).
# La tienda pública se despliega en el dominio principal.
# La administración se despliega en un subdominio independiente.
#
# Ejemplos ficticios — reemplazar con dominios reales en configuración real:
NEXT_PUBLIC_STORE_DOMAIN=www.litoralmaq.com
NEXT_PUBLIC_ADMIN_DOMAIN=admin.litoralmaq.com

# Muestra u oculta los controles de Andreani en el panel admin. Es SOLO una
# señal de interfaz, no un control de seguridad: la autoridad real es
# ANDREANI_ENABLED, que vive como secret del proyecto Supabase (ver
# supabase/functions/.env.example) y hace que las Functions rechacen todo
# con 503. Aunque alguien fuerce esta variable a true en el bundle, no puede
# crear ni cotizar nada.
#
# No es una credencial: es un booleano de UI, por eso sí puede ser
# NEXT_PUBLIC_. Las 5 credenciales de Andreani NUNCA llevan este prefijo.
NEXT_PUBLIC_ANDREANI_UI=false
