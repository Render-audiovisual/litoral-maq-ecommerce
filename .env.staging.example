# Variables para correr los E2E contra un Supabase de staging.
#
#   cp .env.staging.example .env.staging.local   # .env*.local está gitignoreado
#   npx supabase status                          # de ahí salen los valores locales
#   npm run test:e2e:staging
#
# Ninguno de estos valores va nunca a un commit, a un log ni a una captura.
# Los del stack local son constantes públicas del CLI de Supabase (iguales en
# toda máquina); los de un proyecto hosteado son secretos de verdad y viven en
# GitHub Secrets con estos mismos nombres.

# API URL del stack de staging. NUNCA la de producción: playwright.config.ts
# aborta la corrida si detecta el host productivo.
E2E_SUPABASE_URL=http://127.0.0.1:54321

# Clave publicable (o anon) del mismo entorno. Sale de `npx supabase status`
# como PUBLISHABLE_KEY.
E2E_SUPABASE_PUBLISHABLE_KEY=
