# SOLO para scripts/prepare-products-migration.mjs --apply, ejecutado a
# mano por un humano de confianza en su máquina/CI de confianza.
#
# NUNCA con prefijo NEXT_PUBLIC_. NINGÚN archivo dentro de src/ debe
# importar SUPABASE_SERVICE_ROLE_KEY — si alguna vez aparece una referencia
# a esta variable fuera de scripts/, es un error de seguridad grave (la
# service_role se salta RLS por completo).
#
# Uso:
#   cp .env.migration.example .env.migration.local
#   # completar con el valor real (Project Settings → API → service_role)
#   node --env-file=.env.migration.local scripts/prepare-products-migration.mjs --apply

# Valor ficticio de ejemplo — no es una clave real:
SUPABASE_SERVICE_ROLE_KEY=sb_secret_EJEMPLO_FICTICIO_NO_ES_UNA_CLAVE_REAL
