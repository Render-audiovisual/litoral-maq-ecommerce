# Secrets de las Edge Functions andreani-* (supabase/functions/).
#
# NO son variables de Next.js: nunca van en .env.local ni en el bundle de la
# tienda/admin. Viven exclusivamente en el proyecto Supabase, fuera de este
# repo y fuera del navegador.
#
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta la plataforma sola en
# cada función — no se configuran acá.
#
# Setear en real (uno por uno, o con --env-file apuntando a una copia local
# de este archivo con valores reales — nunca commitear esa copia):
#   supabase secrets set ANDREANI_MODE=mock
#
# Para probar localmente antes de tener credenciales:
#   supabase functions serve --env-file supabase/functions/.env.local
#   (con ANDREANI_MODE=mock alcanza; sin esta variable el default YA es mock)

# INTERRUPTOR PRINCIPAL. Apagado por defecto. Mientras sea distinto de
# "true", las tres Functions rechazan CUALQUIER operación con 503 — no
# cotizan, no crean envíos, ni siquiera devuelven un mock. Es independiente
# de ANDREANI_MODE: prender el modo qa/production no sirve de nada si esto
# está apagado, y viceversa.
ANDREANI_ENABLED=false

# mock (default, sin credenciales) | qa | production
ANDREANI_MODE=mock

# Requeridas SOLO cuando ANDREANI_MODE=qa o production — con mock, ni se leen.
# Valores ficticios de ejemplo, pedir los reales al Ejecutivo Comercial de Andreani:
ANDREANI_BASE_URL=https://apisqa.andreani.com
ANDREANI_API_USER=EJEMPLO_FICTICIO_NO_ES_REAL
ANDREANI_API_PASSWORD=EJEMPLO_FICTICIO_NO_ES_REAL
ANDREANI_CLIENT=EJEMPLO_FICTICIO_NO_ES_REAL
ANDREANI_CONTRACT=EJEMPLO_FICTICIO_NO_ES_REAL
